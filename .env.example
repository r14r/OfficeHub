# Copy to .env and replace both secrets before starting.
POSTGRES_DB=officehub
POSTGRES_USER=officehub
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEBUI_SECRET_KEY=replace-with-a-random-64-character-hex-string
OLLAMA_MODEL=llama3.2:1b
OFFICEHUB_PORT=30000
OPEN_WEBUI_PORT=30010

# Models downloaded into the one global Ollama instance by app-specific init jobs.
OPENWEBUI_OLLAMA_MODEL=llama3.2:1b
N8N_OLLAMA_MODEL=llama3.2:1b
